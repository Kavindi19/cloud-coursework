generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  venue          String
  eventDate      DateTime
  ticketPrice    Decimal  @db.Decimal(10, 2)
  capacity       Int
  seatsAvailable Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("events")
}
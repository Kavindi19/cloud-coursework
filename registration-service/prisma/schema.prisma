generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id          Int      @id @default(autoincrement())
  eventId     Int
  name        String
  email       String
  ticketCount Int
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("registrations")
}